<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>zh_CN</string>
	<!-- 显示名用中文；Bundle ID 必须是纯 ASCII（见 project.yml） -->
	<key>CFBundleDisplayName</key>
	<string>时刻</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!-- 图标名：走资源目录（Assets.xcassets）时，系统靠这个名字去 Assets.car 里找图标。
	     本工程的 Info.plist 是手写的（GENERATE_INFOPLIST_FILE = NO），因此这里显式写死，
	     不依赖 Xcode 的自动注入 —— 这一项漏了的后果是图标完全不出现，而构建不报任何错。 -->
	<key>CFBundleIconName</key>
	<string>AppIcon</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- 缺失会被 App Store 上传校验拒绝，这里先放空字典占位 -->
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>

	<!-- ============================================================
	     后台音频执行权：这是「锁屏不停录」的前提。
	     设计文档 3.2 节。录音本身即构成合法的后台执行理由，
	     不需要"播放静音 PCM 保活"这类取巧做法。
	     ============================================================ -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>

	<!-- 麦克风用途说明：必须写清楚用途，既是审核要求也是合规起点。
	     设计文档 3.4 节。 -->
	<key>NSMicrophoneUsageDescription</key>
	<string>用于记录周围讲话并转成文字。录音、转写与翻译全部在本机完成，不会上传到任何服务器。</string>

	<!-- 本项目不使用 Apple 的语音识别框架（转写走 whisper.cpp，全端侧），
	     因此不申请 NSSpeechRecognitionUsageDescription，保持最小权限面。
	     设计文档 4.14 节。 -->

	<!-- 声明未使用非豁免加密算法，免去每次上传被追问出口合规 -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
